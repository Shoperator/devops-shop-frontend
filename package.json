{
  "name": "shop-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "next": "16.2.12",
    "next-runtime-env": "^3.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "comment:overrides": "next-runtime-env@3 lists next@^14 / react@^18 as real dependencies, not just peers, so npm installs a nested Next 14 + React 18 beside ours. Pin both to this app's copies: otherwise the library resolves next/cache against a foreign Next instance and its unstable_noStore() no longer sees our request scope.",
  "overrides": {
    "next-runtime-env": {
      "next": "$next",
      "react": "$react"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
